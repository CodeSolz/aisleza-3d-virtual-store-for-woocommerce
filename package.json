{
  "name": "aisleza",
  "private": true,
  "description": "Build tooling for the 3D store (bundles src/world into assets/js/world.js).",
  "scripts": {
    "build": "esbuild src/world/main.js --bundle --minify --format=iife --target=es2018 --legal-comments=eof --outfile=assets/js/world.js",
    "watch": "esbuild src/world/main.js --bundle --format=iife --target=es2018 --outfile=assets/js/world.js --watch"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "three": "0.187.0"
  }
}
